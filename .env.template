# Copy to .env and fill in. .env is gitignored.

# Google Geocoding API key — used to convert user-typed location/zip to lat/lng.
# Get one at: https://console.cloud.google.com/google/maps-apis/credentials
# Recommended: set a daily quota cap (e.g., 500/day) on the Geocoding API SKU
# in Cloud Console to prevent surprise billing.
GOOGLE_MAPS_API_KEY=

# Optional: path to the Google Sheets service-account JSON key.
# Defaults to "service-account.json" in the current directory if unset.
# Locally: rename the downloaded JSON to service-account.json and drop it in the project root.
# In Cloud Run: mount the Secret Manager secret at /secrets and set this to /secrets/service-account.json.
# GOOGLE_SERVICE_ACCOUNT_FILE=/secrets/service-account.json
